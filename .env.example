# Copy this file to `.env` and fill in the values you need.
# Nothing here is required for the core game (`uv sync && uv run python main.py`
# with the default RandomClueAgent) — these only matter once you opt into an
# LLM provider and/or tracing via the optional dependency groups in
# pyproject.toml. Every LLM provider client lazily reads its key from the
# environment at call time (see agents/langchain_client.py), so only set the
# keys for the provider(s) you're actually using.

# --- LLM providers (uv sync --extra langchain) --------------------------
# Set only the key(s) for the provider(s) you pass to create_llm_client().

# Required for create_llm_client("anthropic", ...) / anthropic_client(...)
ANTHROPIC_API_KEY=

# Required for create_llm_client("openai", ...) / openai_client(...)
OPENAI_API_KEY=

# Required for create_llm_client("gemini", ...) / gemini_client(...)
GOOGLE_API_KEY=

# Required for create_llm_client("cerebras", ...) / cerebras_client(...)
CEREBRAS_API_KEY=

# create_llm_client("ollama", ...) / ollama_client(...) needs no API key —
# it talks to a local Ollama server. Uncomment only if yours isn't at the
# default http://localhost:11434.
# OLLAMA_BASE_URL=

# --- OpenTelemetry tracing (uv sync --extra otel) ------------------------
# Read by configure_tracing() in telemetry.py via the standard OTel SDK env
# vars — see https://opentelemetry.io/docs/specs/otel/protocol/exporter/.
# All optional; OTEL_EXPORTER_OTLP_ENDPOINT defaults to http://localhost:4317
# if unset, so an OTLP collector running locally needs nothing set at all.

# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# OTEL_EXPORTER_OTLP_HEADERS=

# --- LangSmith tracing (uv sync --extra langsmith, needs --extra langchain too) ---
# Read directly from the environment by configure_langsmith_tracing() in
# telemetry.py (see README.md's "Tracing (LangSmith)" section). Tracing
# stays off until LANGSMITH_API_KEY is set — without it, LLM calls just run
# untraced rather than the game failing.

# Required to actually export traces to LangSmith.
LANGSMITH_API_KEY=

# Optional — configure_langsmith_tracing() defaults this to "clueforagents"
# if unset; override here to route traces to a different LangSmith project.
# LANGSMITH_PROJECT=clueforagents

# Optional — only needed for a self-hosted LangSmith instance.
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
